<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.heygeo.tunnel</string>

    <!-- Chạy với user m2pro – cần để đọc ~/.cloudflared/ -->
    <key>UserName</key>
    <string>m2pro</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/cloudflared</string>
        <string>tunnel</string>
        <string>--config</string>
        <string>/Users/m2pro/HeyGeo/cloudflared/config.yml</string>
        <string>--no-autoupdate</string>
        <string>run</string>
        <string>heygeo</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/m2pro/HeyGeo</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/m2pro</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/m2pro/HeyGeo/logs/tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/m2pro/HeyGeo/logs/tunnel.log</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Tự restart nếu tunnel đứt kết nối, chờ tối thiểu 10 giây -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
