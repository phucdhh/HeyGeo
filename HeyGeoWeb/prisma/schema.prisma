// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String?        @unique  // public slug, e.g. "nguyendangminhphuc"
  name          String?
  avatar        String?        // relative URL, e.g. /avatars/clxxx.jpg
  bio           String?
  phone         String?
  password      String
  role          Role           @default(USER)
  models           Model[]
  comments         Comment[]
  commentReactions CommentReaction[]
  modelReactions   ModelReaction[]
  apiTokens        ApiToken[]
  notifications    Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Model {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  guide         String?  @db.Text   // Step-by-step exploration guide shown on share page
  jsonData      Json                 // JSXGraph construction JSON exported by HeyGeo Qt app
  thumbnailSvg  String?  @db.Text   // SVG thumbnail generated by HeyGeo Desktop on export
  categories    String[] @default([])
  isPublic      Boolean  @default(false)
  publishedAt   DateTime?                    // set/updated whenever isPublic transitions to true
  shareToken    String?  @unique @default(cuid())
  viewCount     Int      @default(0)
  comments      Comment[]
  reactions     ModelReaction[]
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([shareToken])
}

enum CommentVisibility {
  PUBLIC
  REGISTERED_ONLY
}

model Comment {
  id         String            @id @default(cuid())
  content    String            @db.Text
  visibility CommentVisibility @default(REGISTERED_ONLY)
  isDeleted  Boolean           @default(false)
  isVerified Boolean           @default(false)
  editedAt   DateTime?
  modelId    String
  model      Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies    Comment[]         @relation("CommentReplies")
  reactions  CommentReaction[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([modelId])
  @@index([userId])
  @@index([parentId])
}

enum ReactionType {
  LIKE
  LOVE
  AMAZING
  NOT_UNDERSTAND
}

model ModelReaction {
  id        String       @id @default(cuid())
  modelId   String
  model     Model        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([modelId, userId])
  @@index([modelId])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "like" | "question" | "insight"
  createdAt DateTime @default(now())

  @@unique([commentId, userId, type])
  @@index([commentId])
}

enum NotifType {
  ADMIN_MESSAGE
  INACTIVITY_WARNING
  REPLY_ON_COMMENT
  COMMENT_VERIFIED
  COMMENT_REACTION
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotifType @default(ADMIN_MESSAGE)
  message   String    @db.Text
  modelId   String?   // optional – links to a specific model
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// Long-lived tokens for the HeyGeo Qt desktop application
model ApiToken {
  id        String    @id @default(cuid())
  name      String                     // e.g. "HeyGeo Desktop – MacBook Pro"
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsed  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
