# Database
DATABASE_URL="postgresql://heygeo:password@localhost:5432/heygeo"

# JWT Secret – generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-random-64-char-secret"

# Port (tránh xung đột với các app khác dùng 3000)
PORT=3535

# Public base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL="https://heygeo.pedu.vn"

# Environment
NODE_ENV="production"

# Absolute path to the folder containing release zip files (served via /api/download/)
# On the server: /Users/m2pro/HeyGeo/release
RELEASE_DIR="/Users/m2pro/HeyGeo/release"
